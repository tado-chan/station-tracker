{
	"appId": "com.stationtracker.app",
	"appName": "駅記録アプリ",
	"webDir": "www",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"LocalNotifications": {
			"smallIcon": "ic_stat_icon_config_sample",
			"iconColor": "#488AFF",
			"sound": "beep.wav"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"packageClassList": [
		"LocalNotificationsPlugin",
		"PushNotificationsPlugin",
		"LocationEntity",
		"StationTrackerGeolocationPlugin"
	]
}
